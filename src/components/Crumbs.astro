---
// Trilha de navegação. O JSON-LD correspondente é gerado por breadcrumbSchema().
interface Props { items: { href?: string; label: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Você está em">
  <ol class="crumbs">
    <li><a href="/">Início</a></li>
    {items.map((it) => <li>{it.href ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}</li>)}
  </ol>
</nav>
