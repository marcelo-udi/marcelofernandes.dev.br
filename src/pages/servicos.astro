---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Crumbs from '../components/Crumbs.astro';
import SectionHead from '../components/SectionHead.astro';
import Steps from '../components/Steps.astro';
import Cta from '../components/Cta.astro';
import { SERVICES } from '../data/services';
import { breadcrumbSchema } from '../data/schema';

const principais = SERVICES.filter((s) => s.group === 'principal');
const complementares = SERVICES.filter((s) => s.group === 'complementar');
---
<Base
  title="Serviços: Sites, Software, IA, Nuvem e Segurança | Marcelo Fernandes"
  description="Criação de sites, software sob medida, inteligência artificial e computação em nuvem. Também reviso a segurança de sites e dados. Atendimento em Uberlândia e remoto."
  path="/servicos.html"
  schema={[breadcrumbSchema([{ href: '/servicos.html', label: 'Serviços' }])]}
>
  <header class="page-head">
    <div class="wrap page-head-grid">
      <Crumbs items={[{ label: 'Serviços' }]} />
      <h1 class="h1">Serviços</h1>
      <p class="lead">Crio sites e software, integro inteligência artificial a tarefas práticas, publico aplicações em nuvem e reviso a segurança de sites e dados. Veja o que cada serviço inclui.</p>
    </div>
  </header>

  <section class="section" aria-labelledby="principais">
    <div class="wrap">
      <SectionHead label="Principais" title="Sites, software e segurança" id="principais" />
      <div class="grid grid-3">
        {principais.map((s) => (
          <a class="card reveal" href={`/${s.slug}.html`}>
            <span class="card-icon"><Icon name={s.icon} /></span>
            <h3 class="h3">{s.name}</h3>
            <p>{s.lead}</p>
            <ul class="check-list" style="font-size:.95rem">
              {s.includes.slice(0, 3).map((i) => <li><Icon name="Check" />{i}</li>)}
            </ul>
            <span class="link-arrow">Ver detalhes <Icon name="ArrowRight" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--line" aria-labelledby="complementares">
    <div class="wrap">
      <SectionHead label="Outros serviços" title="Inteligência artificial, nuvem e mais" id="complementares" />
      <div class="grid grid-2">
        {complementares.map((s) => (
          <a class="card reveal" href={`/${s.slug}.html`}>
            <h3 class="h3" style="display:flex;gap:10px;align-items:center"><Icon name={s.icon} />{s.name}</h3>
            <p>{s.lead}</p>
            <span class="link-arrow">Ver detalhes <Icon name="ArrowRight" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--line" aria-labelledby="etapas">
    <div class="wrap">
      <SectionHead label="Como funciona" title="Da conversa à entrega" id="etapas" />
      <Steps steps={SERVICES[0].steps} />
    </div>
  </section>

  <Cta title="Não sabe qual serviço é o seu caso?" text="Descreva o problema com as suas palavras. Eu digo qual é o caminho mais simples e quanto custa, sem compromisso." />
</Base>
