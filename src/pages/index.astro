---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { SERVICES } from '../data/services';
import { PROJECTS } from '../data/projects';
import { whatsapp } from '../data/site';
import { faqSchema } from '../data/schema';
import heroPhoto from '../assets/marcelo-hero.webp';
import aboutPhoto from '../assets/marcelofernandes.jpg';

const wordmark = ['MARCELO', 'FERNANDES'];
const principais = SERVICES.filter((s) => s.group === 'principal');
const complementares = SERVICES.filter((s) => s.group === 'complementar');

const pairs = [
  { p: 'Sua empresa precisa de uma página que explique o que faz e ajude o cliente a entrar em contato.', a: 'Crio um site claro, rápido no celular e preparado para as buscas, com acesso fácil ao WhatsApp.', href: '/site_institucional.html', link: 'Criação de sites e lojas' },
  { p: 'Pedidos e informações estão espalhados em planilhas, mensagens e programas diferentes.', a: 'Desenvolvo um sistema para organizar tudo em um só lugar e mostrar à equipe o andamento de cada pedido.', href: '/software.html', link: 'Software sob medida' },
  { p: 'Você não sabe quem tem acesso ao servidor nem se conseguiria recuperar os dados.', a: 'Reviso acessos, atualizações e cópias de segurança, e entrego um relatório com o que precisa ser corrigido.', href: '/seguranca_cibernetica.html', link: 'Segurança de sites e dados' },
];

const principles = [
  { t: 'Preço fechado antes de começar', d: 'Escopo, prazo e valor por escrito. Se algo mudar no caminho, conversamos antes de qualquer custo extra.' },
  { t: 'Tudo no seu nome', d: 'Domínio, contas, código e acessos são seus. Você nunca fica refém de mim.' },
  { t: 'Rápido até com sinal fraco', d: 'Páginas enxutas, sem excesso de scripts e plugins, que abrem rápido no celular do seu cliente.' },
  { t: 'Sempre com caminho de volta', d: 'Antes de mexer em algo que está no ar, faço backup e deixo anotado como desfazer.' },
  { t: 'Segurança no básico bem feito', d: 'HTTPS, senhas e chaves fora do código, acessos mínimos e sistema atualizado.' },
  { t: 'Documentado para continuar', d: 'Você recebe instruções de uso. Se um dia trocar de profissional, o próximo continua de onde eu parei.' },
];

const faq = [
  { q: 'Quanto custa?', a: 'Depende do escopo: número de páginas, integrações e o que precisa ser automatizado. Você recebe uma proposta fechada, com prazo e valor, antes de qualquer compromisso. O orçamento é gratuito e sem compromisso.' },
  { q: 'Atende só em Uberlândia?', a: 'Não. Atendo presencialmente em Uberlândia-MG e de forma remota em todo o Brasil, pelo WhatsApp e por videochamada.' },
  { q: 'Preciso saber exatamente o que quero?', a: 'Não. Basta explicar o problema com as suas palavras e contar como as coisas funcionam hoje. Transformar isso em um escopo claro é trabalho meu.' },
  { q: 'Com quem eu vou falar?', a: 'Comigo, do primeiro contato à entrega. Não há intermediários nem atendimento terceirizado.' },
  { q: 'E depois que o projeto for entregue?', a: 'Você recebe os acessos e as instruções. Ajustes, suporte e manutenção mensal são combinados na proposta, conforme a sua necessidade.' },
];
---
<Base
  title="Marcelo Fernandes | Criação de Sites, Software e Segurança em Uberlândia"
  description="Criação de sites, software sob medida e revisão da segurança de sites e dados para pequenas empresas. Atendimento direto em Uberlândia-MG e em todo o Brasil. Peça um orçamento gratuito."
  path="/"
  schema={[faqSchema(faq)]}
>
  <!-- 1. Hero -->
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="wrap">
    <div class="hero-top hud" aria-hidden="true">
      <span>Sites · Software · Segurança</span>
      <span>Uberlândia-MG · Brasil</span>
    </div>
    <div class="wordmark" role="img" aria-label="Marcelo Fernandes">
      {wordmark.map((line, l) => (
        <p aria-hidden="true">{[...line].map((ch, i) => <span style={`--i:${l * 7 + i}`}>{ch}</span>)}</p>
      ))}
    </div>
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 id="hero-titulo">Seu negócio precisa de um site claro, um sistema útil e <em>dados mais seguros</em>.</h1>
        <p class="lead">Sou Marcelo Fernandes. Crio páginas para apresentar sua empresa, desenvolvo software para organizar o trabalho e reviso a segurança de sites e servidores. Você fala diretamente comigo, do orçamento à entrega.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={whatsapp()} target="_blank" rel="noopener" data-track="whatsapp_hero">
            <Icon name="MessageCircle" />Quero um orçamento grátis
          </a>
          <a class="btn btn--ghost" href="#projetos">Ver trabalhos no ar</a>
        </div>
        <ul class="hero-proof">
          <li><Icon name="Check" />Você fala direto comigo. Sem intermediário, sem atendente.</li>
          <li><Icon name="Check" />Preço e prazo fechados por escrito antes de começar.</li>
          <li><Icon name="Check" />Domínio, código e acessos ficam no seu nome.</li>
        </ul>
      </div>
      <div class="portrait">
        <div class="portrait-bar hud"><span>Retrato</span><span>MF / 2026</span></div>
        <div class="portrait-frame">
          <Image src={heroPhoto} alt="Marcelo Fernandes, desenvolvedor em Uberlândia-MG" widths={[320, 480, 640]}
            sizes="(min-width: 960px) 420px, 88vw" loading="eager" fetchpriority="high" quality={80} />
        </div>
        <div class="status-card">
          <span class="status-dot">Agenda aberta para novos projetos</span>
          <span class="mono">Resposta pelo WhatsApp · (34) 99892-8444</span>
        </div>
      </div>
    </div>
    </div>
  </section>

  <div class="marquee">
    {[0, 1].map((copy) => (
      <ul class="marquee-track" aria-hidden={copy === 1 ? 'true' : undefined}>
        {SERVICES.map((s) => <li class="hud">{s.name}</li>)}
      </ul>
    ))}
  </div>

  <!-- 2. Problemas reais -->
  <section class="section section--line" aria-labelledby="problemas">
    <div class="wrap">
      <SectionHead num="01" label="O que eu resolvo" title="Qual destes problemas você quer *resolver*?" id="problemas" split>
        Veja exemplos de como um site, um software ou uma revisão de segurança podem ajudar sua empresa.
      </SectionHead>
      <div class="pairs reveal">
        {pairs.map((x) => (
          <div class="pair">
            <p class="pair-problem">{x.p}</p>
            <p class="pair-answer"><Icon name="CornerDownRight" />{x.a}</p>
            <a class="link-arrow" href={x.href}>{x.link} <Icon name="ArrowRight" /></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Serviços -->
  <section class="section" id="servicos" aria-labelledby="servicos-titulo">
    <div class="wrap">
      <SectionHead num="02" label="Serviços" title="O que posso fazer *pela sua empresa*" id="servicos-titulo">
        Meu foco é criar sites, desenvolver software e revisar a segurança de sites e dados. Veja o que cada serviço inclui.
      </SectionHead>
      <div class="grid grid-3">
        {principais.map((s) => (
          <a class="card card--service reveal" href={`/${s.slug}.html`}>
            <span class="card-icon"><Icon name={s.icon} /></span>
            <h3 class="h3">{s.name}</h3>
            <p>{s.summary}</p>
            <span class="link-arrow">Saiba mais <Icon name="ArrowRight" /></span>
          </a>
        ))}
      </div>
      <div class="grid grid-3" style="margin-top:16px">
        {complementares.map((s) => (
          <a class="card card--compact reveal" href={`/${s.slug}.html`}>
            <h3 class="h3" style="display:flex;gap:10px;align-items:center"><Icon name={s.icon} />{s.name}</h3>
            <p>{s.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Projetos -->
  <section class="section section--line" id="projetos" aria-labelledby="projetos-titulo">
    <div class="wrap">
      <SectionHead num="03" label="Projetos" title="Trabalhos reais, que você pode *abrir e conferir*" id="projetos-titulo" split>
        Cada projeto mostra o problema, a solução e um link para você conhecer o trabalho.
      </SectionHead>
      <div class="grid" style="gap:24px">
        {PROJECTS.map((p, i) => <ProjectCard project={p} flip={i % 2 === 1} />)}
      </div>
      <p style="margin-top:28px"><a class="link-arrow" href="/projetos/">Todos os projetos <Icon name="ArrowRight" /></a></p>
    </div>
  </section>

  <!-- 5. Diferenciais -->
  <section class="section dark" aria-labelledby="como-trabalho">
    <div class="wrap">
      <SectionHead num="04" label="Como trabalho" title="O que você pode esperar de *cada projeto*" id="como-trabalho" split>
        Explico o que será feito, combino preço e prazo e entrego os acessos a você.
      </SectionHead>
      <ul class="principles">
        {principles.map((x, i) => (
          <li class="reveal">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{x.t}</h3>
            <p>{x.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6. Metodologia -->
  <section class="section" aria-labelledby="metodo">
    <div class="wrap">
      <SectionHead num="05" label="Etapas" title="Do primeiro contato à *entrega*" id="metodo">
        Você acompanha as etapas e aprova o projeto antes da publicação.
      </SectionHead>
      <Steps steps={SERVICES[0].steps} />
    </div>
  </section>

  <!-- 7. Sobre -->
  <section class="section section--line" aria-labelledby="sobre">
    <div class="wrap about">
      <div class="about-photo reveal">
        <Image src={aboutPhoto} alt="Retrato de Marcelo Fernandes" widths={[360, 560]} sizes="(min-width: 900px) 440px, 90vw" loading="lazy" quality={78} format="webp" />
      </div>
      <div class="about-copy reveal">
        <p class="eyebrow"><b>06</b>Sobre</p>
        <h2 class="h2" id="sobre">Prazer, eu sou o <em>Marcelo</em>.</h2>
        <p>Há mais de 7 anos resolvo problemas com tecnologia, e atendo pessoalmente cada projeto. Antes de propor qualquer ferramenta, quero entender como o seu negócio funciona: quase sempre, a melhor solução é a mais simples que resolve.</p>
        <p>No dia a dia, crio sites e software, reviso a segurança de servidores e cuido da infraestrutura dos meus próprios projetos.</p>
        <p><a class="link-arrow" href="/sobre.html">Conheça a minha trajetória e a forma de trabalhar <Icon name="ArrowRight" /></a></p>
      </div>
    </div>
  </section>

  <!-- 8. Perguntas -->
  <section class="section section--line" aria-labelledby="duvidas">
    <div class="wrap split">
      <SectionHead num="07" label="Dúvidas" title="Perguntas *frequentes*" id="duvidas">
        Não achou a sua dúvida? <a href={whatsapp('Olá, Marcelo! Tenho uma dúvida antes de pedir orçamento.')} target="_blank" rel="noopener">Pergunte pelo WhatsApp</a>.
      </SectionHead>
      <Faq items={faq} />
    </div>
  </section>

  <!-- 9. Chamada final -->
  <Cta />
</Base>
