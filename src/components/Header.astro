---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { NAV, whatsapp } from '../data/site';

interface Props { path: string }
const { path } = Astro.props;

// Página atual (ou seção dela) para marcar o item do menu
const servicePages = ['/servicos.html', '/site_institucional.html', '/software.html', '/automacao_relatorios.html',
  '/manutencao_servidores.html', '/cloud.html', '/seguranca_cibernetica.html', '/ia.html', '/material-grafico.html'];
const isCurrent = (href: string) => {
  if (href === '/servicos.html') return servicePages.includes(path);
  if (href.endsWith('/')) return path.startsWith(href);
  return path === href;
};
---
<header class="site-header" id="topo">
  <div class="header-row">
    <a class="brand" href="/">
      <Logo class="brand-mark" />
      <span>Marcelo Fernandes<small>Dev · Uberlândia-MG</small></span>
    </a>
    <nav class="nav" aria-label="Principal">
      <ul>
        {NAV.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}><span>{item.label}</span></a></li>
        ))}
      </ul>
    </nav>
    <div class="header-tools">
      <button class="icon-btn theme-btn" type="button" data-theme-btn aria-label="Alternar tema claro/escuro">
        <Icon name="Moon" class="i-moon" />
        <Icon name="Sun" class="i-sun" />
      </button>
      <a class="header-cta" href={whatsapp()} target="_blank" rel="noopener" data-track="whatsapp_cabecalho">
        <Icon name="MessageCircle" />Pedir orçamento
      </a>
      <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="menu-celular" data-menu-btn>
        <span class="sr-only">Abrir menu</span>
        <Icon name="Menu" class="i-open" />
        <Icon name="X" class="i-close" />
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="menu-celular" hidden>
    <nav aria-label="Principal (celular)">
      <ul>
        <li><a href="/">Início <Icon name="ArrowRight" /></a></li>
        {NAV.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label} <Icon name="ArrowRight" /></a></li>
        ))}
      </ul>
    </nav>
    <a class="btn btn--primary" href={whatsapp()} target="_blank" rel="noopener" data-track="whatsapp_menu">
      <Icon name="MessageCircle" />Pedir orçamento pelo WhatsApp
    </a>
  </div>
</header>
