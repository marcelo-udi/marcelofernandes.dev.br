---
import Logo from './Logo.astro';
import { SITE, whatsapp } from '../data/site';
import { SERVICES } from '../data/services';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-about">
        <a class="brand" href="/">
          <Logo class="brand-mark" />
          <span>Marcelo Fernandes</span>
        </a>
        <p>Sites, software, inteligência artificial, computação em nuvem e segurança de sites e dados para pequenas empresas. Atendimento direto em Uberlândia-MG e em todo o Brasil.</p>
      </div>
      <div>
        <h2>Serviços</h2>
        <ul>
          {[...SERVICES.filter((s) => s.group === 'principal'), ...SERVICES.filter((s) => s.group === 'complementar')].map((s) => <li><a href={`/${s.slug}.html`}>{s.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Site</h2>
        <ul>
          <li><a href="/projetos/">Projetos</a></li>
          <li><a href="/sobre.html">Sobre</a></li>
          <li><a href="/blog/">Conteúdo técnico</a></li>
          <li><a href="/contato.html">Contato e orçamento</a></li>
          <li><a href="/privacidade.html">Privacidade</a></li>
        </ul>
      </div>
      <div>
        <h2>Contato</h2>
        <ul>
          <li><a href={whatsapp()} target="_blank" rel="noopener" data-track="whatsapp_rodape">WhatsApp {SITE.phoneDisplay}</a></li>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.github} target="_blank" rel="noopener">GitHub</a></li>
          <li>Uberlândia-MG · atendimento remoto em todo o Brasil</li>
        </ul>
      </div>
    </div>
    <div class="footer-mark" aria-hidden="true"><span>FERNANDES</span></div>
    <div class="footer-bottom">
      <span>© {year} Marcelo Fernandes</span>
      <span>Este site usa o Google Analytics para contar visitas · <a href="/privacidade.html">Política de privacidade</a></span>
    </div>
  </div>
</footer>
