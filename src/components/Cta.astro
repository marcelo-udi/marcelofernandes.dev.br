---
import Icon from './Icon.astro';
import { whatsapp } from '../data/site';

interface Props { title?: string; text?: string; message?: string; servico?: string; track?: string }
const {
  title = 'Conte o que precisa. Eu preparo *uma proposta clara*.',
  text = 'Fale comigo pelo WhatsApp ou preencha o formulário. Eu explico o que pode ser feito e envio prazo e valor por escrito. O orçamento é gratuito.',
  message, servico, track = 'whatsapp_cta',
} = Astro.props;
const titleHtml = title.replace(/\*([^*]+)\*/g, '<em>$1</em>');
const formHref =servico ? `/contato.html?servico=${servico}#orcamento` : '/contato.html#orcamento';
---
<section class="section" aria-labelledby="cta-titulo">
  <div class="wrap">
    <div class="cta reveal">
      <div>
        <h2 class="h2" id="cta-titulo" set:html={titleHtml} />
        <p>{text}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href={whatsapp(message)} target="_blank" rel="noopener" data-track={track}>
          <Icon name="MessageCircle" />Chamar no WhatsApp
        </a>
        <a class="btn btn--ghost" href={formHref}>Prefiro o formulário</a>
      </div>
    </div>
  </div>
</section>
